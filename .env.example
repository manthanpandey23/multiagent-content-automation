# =============================================================================
# Hermes Social Agent — Environment Configuration Template
# Copy to .env and fill in real values. Run: cp .env.example .env
# =============================================================================

# ---------------------------- LLM Providers -----------------------------------
# NVIDIA NIM (primary provider)
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://api.nvidia.com/v1

# OpenRouter (fallback provider — free/low-cost models)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemma-2-9b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------- Telegram Bot ------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_chat_id

# ---------------------------- Database (PostgreSQL) ---------------------------
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_password
POSTGRES_DB=social_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---------------------------- Redis ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380

# ---------------------------- Pipeline ---------------------------------------
PIPELINE_CATEGORIES=AI,Machine Learning,IT Sector,Automation,Cloud Computing,Cybersecurity,Software Engineering,Developer Tools,AI Agents,Generative AI,LLM
PIPELINE_TITLE_MAX_WORDS=100
PIPELINE_DESC_MAX_WORDS=300
PIPELINE_MIN_QUALITY_SCORE=75
PIPELINE_RESEARCH_HOUR=9
PIPELINE_RESEARCH_MINUTE=0
PIPELINE_PUBLISH_HOUR=10
PIPELINE_PUBLISH_MINUTE=0
PIPELINE_TIMEZONE=Asia/Kolkata
PIPELINE_DAILY_LIMIT=5000

# ---------------------------- Guardian (Agent 5) ------------------------------
GUARDIAN_ENABLED=true
GUARDIAN_SEVERITY=warn
GUARDIAN_ALERT_IMMEDIATE=true
GUARDIAN_TOKEN_BUDGET_PER_AGENT=500000

# ---------------------------- Evaluation -------------------------------------
EVAL_ENABLED=true
EVAL_RUN_AFTER_EACH_PIPELINE=true
EVAL_DAILY_REPORT_HOUR=22
EVAL_WEEKLY_REPORT_DAY=sunday
EVAL_WEEKLY_REPORT_HOUR=23
EVAL_MONTHLY_REPORT_DAY=last
EVAL_MONTHLY_REPORT_HOUR=23

# ---------------------------- UI (Streamlit) ---------------------------------
UI_ENABLED=true
UI_PORT=8501
UI_AUTO_REFRESH_SECONDS=30
UI_HOST=0.0.0.0

# ---------------------------- Social Publishing -----------------------------
# Leave empty to use dry-run mode (no actual posts)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_APP_ID=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ---------------------------- Feature Flags ----------------------------------
AUTO_RUN=true
DRY_RUN=false

# ---------------------------- Token Manager (Agent 6) ------------------------
TOKEN_MANAGER_ENABLED=true
TOKEN_SAFETY_MARGIN=1.2
TOKEN_BUDGET_DEFAULT=500000
TOKEN_BUDGET_WARNING=0.80
TOKEN_BUDGET_CRITICAL=0.95
TOKEN_CONTEXT_WARNING=0.70
TOKEN_CACHE_TTL_HOURS=1
TOKEN_CACHE_TTL_LONG=24
TOKEN_CACHE_ENABLED=true
TOKEN_CACHING_ENABLED=true
TOKEN_PROVIDER_SWITCH_AUTO=true
TOKEN_MIN_MODEL_FALLBACK=2B
